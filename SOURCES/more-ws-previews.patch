+            const name = Meta.prefs_get_workspace_name(i);
+            const item = new PopupMenu.PopupMenuItem(name);
 
             item.connect('activate',
                 () => this._activate(i));
@@ -436,7 +436,7 @@ class WorkspaceIndicator extends PanelMenu.Button {
             this._workspacesItems[i] = item;
